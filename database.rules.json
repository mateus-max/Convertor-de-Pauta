{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "partituras": {
          "$scoreId": {
            ".validate": "newData.hasChildren(['title','lyrics','key','notes','updatedAt','ownerUid']) && newData.child('ownerUid').val() === auth.uid",
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 160"
            },
            "lyrics": {
              ".validate": "newData.isString() && newData.val().length <= 20000"
            },
            "key": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "ownerUid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
